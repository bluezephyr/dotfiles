#!/usr/bin/python3

"""Install and configure applications from a declarative list.

List file mode:
  %(prog)s -f <file>
  One application per line, comments and blank lines ignored:
    <application_name> <installer_type> [attributes...]

Single application:
  %(prog)s <application_name> <installer_type> [attributes...]

Other modes:
  %(prog)s -l   list every application and the installers it supports
  %(prog)s -e   print an example list file, e.g. `%(prog)s -e > doc/applications.txt`

Examples:
  %(prog)s -f doc/applications.txt
  %(prog)s nvim appimage
  %(prog)s bashrc config ./bash/bashrc-custom
"""

import argparse
import os
import re
import shutil
import subprocess
import urllib.request
from collections import namedtuple
from pathlib import Path

HOME = Path.home()
BIN_DIR = HOME / ".local" / "bin"


# ---------------------------------------------------------------------------
# APPLICATIONS
# ---------------------------------------------------------------------------
#
# Add an application by adding an entry here. Nothing else needs to change
# unless the application needs an installer that does not exist yet.
#
#   "<app name>": {
#       "command":    executable the application provides, used to detect an
#                     existing installation. Omit when it provides none.
#       "installers": {"<installer type>": {<spec>}, ...}
#   }
#
# An application may support any number of installer types; the one to use is
# chosen in the list file or on the command line, never here. See INSTALL
# MECHANISMS for the code reading each spec:
#
#   apt, pacman   "package"   package name, defaults to the application name
#                 "symlink"   (source_command, link_name) made in ~/.local/bin
#   appimage      "url"       download location
#                 "target"    name in ~/.local/bin, defaults to the app name
#   config        "target"    file to update, ~ is expanded
#                 "marker"    name of the "# start/end <marker>" block to
#                             replace. The content comes from the file given
#                             as an attribute: `bashrc config ./bashrc-custom`

APPS = {
    "bash-profile": {
        "installers": {
            "config": {
                "target": "~/.config/bash/profile_custom",
                "marker": "custom_bash_profile",
            },
        },
    },
    "bashrc": {
        "installers": {
            "config": {
                "target": "~/.config/bash/bashrc_custom",
                "marker": "custom_bashrc",
            },
        },
    },
    "fd": {
        "command": "fd",
        "installers": {
            # Debian ships the binary as fdfind to avoid a name clash.
            "apt": {"package": "fd-find", "symlink": ("fdfind", "fd")},
            "pacman": {"package": "fd"},
        },
    },
    "fzf": {
        "command": "fzf",
        "installers": {"apt": {}},
    },
    "lazygit": {
        "command": "lazygit",
        "installers": {"apt": {}},
    },
    "nvim": {
        "command": "nvim",
        "installers": {
            "appimage": {
                "url": "https://github.com/neovim/neovim/releases/latest/"
                       "download/nvim-linux-x86_64.appimage",
            },
        },
    },
}


# ---------------------------------------------------------------------------
# INSTALL MECHANISMS
# ---------------------------------------------------------------------------
#
# Add an installer type by writing an install function and registering it in
# MECHANISMS at the end of this section.
#
#   install   install(app_name, spec, attributes) -> None
#   requires  command that must be on PATH for this mechanism to work here
#   prepare   run once before the first install through this mechanism

Mechanism = namedtuple("Mechanism", "install requires prepare", defaults=(None, None))


def apt_update():
    """Refresh the apt package index."""
    run(["sudo", "apt", "update"])


def apt_install(app_name, spec, attributes):
    """Install an apt package, optionally symlinking it under another name."""
    if not run(["sudo", "apt", "install", "-y", spec.get("package", app_name)]):
        return
    if "symlink" in spec:
        create_symlink(BIN_DIR, *spec["symlink"])


def pacman_install(app_name, spec, attributes):
    """Install a pacman package, upgrading the system as Arch requires."""
    run(["sudo", "pacman", "-Syu", spec.get("package", app_name)])


def appimage_install(app_name, spec, attributes):
    """Download an AppImage into ~/.local/bin and make it executable."""
    target = BIN_DIR / spec.get("target", app_name)
    try:
        urllib.request.urlretrieve(spec["url"], target)
    except Exception as e:
        print(f"Failed to download {app_name}: {e}")
        return

    target.chmod(target.stat().st_mode | 0o100)
    print(f"{app_name} installed to {target}")


def config_install(app_name, spec, attributes):
    """Copy a source file into a marked block of a config file."""
    if not attributes:
        print(f"Error: {app_name} needs a source file, e.g. `{app_name} config ./source`")
        return

    source = Path(attributes[0])
    try:
        content = source.read_text()
    except OSError as e:
        print(f"Error: could not read source file {source}: {e}")
        return

    target = Path(spec["target"]).expanduser()
    update_config_file(target, spec["marker"], content)
    print(f"{app_name} written to {target}")


MECHANISMS = {
    "apt": Mechanism(install=apt_install, requires="apt", prepare=apt_update),
    "pacman": Mechanism(install=pacman_install, requires="pacman"),
    "appimage": Mechanism(install=appimage_install),
    "config": Mechanism(install=config_install),
}


# ---------------------------------------------------------------------------
# CORE HELPERS
# ---------------------------------------------------------------------------

def run(command):
    """Run a command, reporting failure. Returns True when it succeeded."""
    try:
        subprocess.run(command, check=True)
        return True
    except (subprocess.CalledProcessError, OSError) as e:
        print(f"Command failed: {' '.join(command)}: {e}")
        return False


def command_version(command):
    """First line of `<command> --version`, or None if unavailable."""
    try:
        result = subprocess.run(
            [command, "--version"], capture_output=True, text=True, timeout=5
        )
    except Exception:
        return None

    if result.returncode != 0:
        return None
    return result.stdout.strip().split("\n")[0]


def update_config_file(file_path, marker_name, content):
    """Update the block delimited by "# start/end <marker_name>" in a file.

    Appends the block when it is not there yet, creating the file and its
    parent directories.
    """
    target = Path(file_path)
    target.parent.mkdir(parents=True, exist_ok=True)
    target.touch()

    start_marker = f"# start {marker_name}"
    end_marker = f"# end {marker_name}"
    new_block = f"{start_marker}\n{content.strip()}\n{end_marker}"

    current_content = target.read_text()

    # Use re.escape so marker names with special chars don't break the regex
    pattern = re.compile(
        rf"{re.escape(start_marker)}.*?{re.escape(end_marker)}",
        re.DOTALL
    )

    if pattern.search(current_content):
        updated_content = pattern.sub(new_block, current_content)
    else:
        # Ensure a newline if the file has content but doesn't end with a newline
        prefix = "\n" if current_content and not current_content.endswith("\n") else ""
        updated_content = f"{current_content}{prefix}{new_block}\n"

    target.write_text(updated_content)


def create_symlink(bin_dir, source_command, link_name):
    """Link bin_dir/link_name to source_command as found on PATH."""
    source_path = shutil.which(source_command)
    if not source_path:
        print(f"Error: Could not find {source_command} in system PATH.")
        return

    link_path = bin_dir / link_name
    if link_path.exists() or link_path.is_symlink():
        link_path.unlink()

    try:
        os.symlink(source_path, link_path)
        print(f"Symlinked {source_command} -> {link_path}")
    except OSError as e:
        print(f"Failed to create symlink: {e}")


# ---------------------------------------------------------------------------
# DRIVER
# ---------------------------------------------------------------------------

Job = namedtuple("Job", "app_name mechanism_name spec attributes")


def read_installations(file_path):
    """Parse a list file into (app_name, mechanism_name, attributes) tuples."""
    path = Path(file_path)
    if not path.exists():
        raise FileNotFoundError(f"File '{file_path}' not found.")

    installations = []
    for line_num, line in enumerate(path.read_text().splitlines(), 1):
        line = line.split("#", 1)[0].strip()
        if not line:
            continue

        parts = line.split()
        if len(parts) < 2:
            raise ValueError(f"Malformed input on line {line_num}: {line!r}")
        installations.append((parts[0], parts[1], parts[2:]))

    return installations


def resolve(app_name, mechanism_name, attributes):
    """Build a Job from an (application, installer type) pair.

    Returns None after explaining why, when the pair cannot be installed.
    """
    app = APPS.get(app_name)
    if app is None:
        print(f"Unknown application: {app_name}")
        return None

    if mechanism_name not in app["installers"]:
        supported = ", ".join(sorted(app["installers"]))
        print(f"No installer for {app_name} via {mechanism_name}; it supports: {supported}")
        return None

    if mechanism_name not in MECHANISMS:
        print(f"Unknown installer type: {mechanism_name}")
        return None

    return Job(app_name, mechanism_name, app["installers"][mechanism_name], attributes)


def prepare_environment():
    """Create the directories installs write to and prune dangling links."""
    for directory in (BIN_DIR, HOME / ".local" / "scripts", HOME / ".config"):
        directory.mkdir(parents=True, exist_ok=True)

    for item in BIN_DIR.iterdir():
        if item.is_symlink() and not item.exists():
            print(f"Removing broken link: {item.name}")
            item.unlink()


def confirm_update(app_name, command):
    """Ask whether to reinstall an application, showing its current version."""
    version = command_version(command)
    version_str = f" (version: {version})" if version else ""
    choice = input(f" {app_name} is already installed{version_str}. Update? (y/N): ")
    return choice.lower() == "y"


def install_job(job):
    """Install one job, prompting first when the application is already there."""
    print("-" * 30)
    print(f"Installing: {job.app_name}")

    command = APPS[job.app_name].get("command")
    if command and shutil.which(command) and not confirm_update(job.app_name, command):
        return

    MECHANISMS[job.mechanism_name].install(job.app_name, job.spec, job.attributes)


def run_jobs(jobs):
    """Install every job, preparing each installer type at most once."""
    prepared = set()
    for job in jobs:
        mechanism = MECHANISMS[job.mechanism_name]
        if mechanism.requires and not shutil.which(mechanism.requires):
            print(f"Skipping {job.app_name}: {job.mechanism_name} is not available here")
            continue

        if mechanism.prepare and job.mechanism_name not in prepared:
            prepared.add(job.mechanism_name)
            mechanism.prepare()

        install_job(job)


def list_apps():
    """Print every (application, installer type) pair that can be installed."""
    print("Available installers:")
    print("-" * 50)
    print(f"  {'Application':<20} {'Type'}")
    print("-" * 50)

    for app_name, app in sorted(APPS.items()):
        for mechanism_name in sorted(app["installers"]):
            print(f"  {app_name:<20} {mechanism_name}")


def print_example():
    """Print a list file covering every application, ready to be edited."""
    print("# Configuration example file for appinstall")
    print("# Generated by `appinstall -e`; alternative installers are commented out.")
    print("# application   installer    parameters")

    for app_name, app in sorted(APPS.items()):
        for index, mechanism_name in enumerate(sorted(app["installers"])):
            prefix = "" if index == 0 else "# "
            parameters = "  <source file>" if mechanism_name == "config" else ""
            # Pad past the comment prefix so the columns stay aligned.
            print(f"{prefix}{app_name:<{15 - len(prefix)}} {mechanism_name:<12}{parameters}".rstrip())


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def main():
    """Parse arguments and run the requested mode."""
    parser = argparse.ArgumentParser(
        description="A modular application installer script.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )

    parser.add_argument(
        "-f", "--file",
        help="Path to the applications list file"
    )

    parser.add_argument(
        "-l", "--list",
        action="store_true",
        help="List all available installers"
    )

    parser.add_argument(
        "-e", "--example",
        action="store_true",
        help="Print an example applications list file"
    )

    parser.add_argument(
        "app_args",
        nargs="*",
        help="Application name, installer type, and optional attributes"
    )

    args = parser.parse_args()

    if args.list:
        list_apps()
        return

    if args.example:
        print_example()
        return

    if args.file:
        try:
            installations = read_installations(args.file)
        except (FileNotFoundError, ValueError) as e:
            parser.error(str(e))
    elif args.app_args:
        if len(args.app_args) < 2:
            parser.error("Interactive mode requires at least <application_name> and <installer_type>")
        installations = [(args.app_args[0], args.app_args[1], args.app_args[2:])]
    else:
        parser.error("Mode selection required")

    jobs = [job for job in (resolve(*item) for item in installations) if job]
    if not jobs:
        return

    prepare_environment()
    run_jobs(jobs)


if __name__ == "__main__":
    main()
